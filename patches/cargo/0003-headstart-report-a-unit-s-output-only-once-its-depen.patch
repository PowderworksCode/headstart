+#[cargo_test(nightly, reason = "-Zearly-metadata is unstable")]
+fn dependency_error_drops_dependent_output() {
+    // `dep`'s interface is fine, so `app` can start on its early metadata
+    // before the error in `f`'s body is found. `app`'s warning must not be
+    // shown: without `-Zheadstart`, `app` would never have been compiled.
+    let p = dep_and_app(
+        r#"pub fn f() -> u32 { "not a number" }"#,
+        "fn main() { let unused = dep::f(); }",
+    );
+
+    for command in ["check", "build"] {
+        p.cargo(command)
+            .arg("-Zheadstart")
+            .masquerade_as_nightly_cargo(&["headstart"])
+            .with_status(101)
+            .with_stderr_contains("[ERROR] could not compile `dep` (lib) due to 1 previous error")
+            .with_stderr_does_not_contain("[..]unused[..]")
+            .with_stderr_does_not_contain("[..]`app`[..]")
+            .run();
+    }
+}
+
+#[cargo_test(nightly, reason = "-Zearly-metadata is unstable")]
+fn dependent_output_released() {
+    // `app` may finish before `dep` does; its warnings, and then its errors,
+    // are held until `dep` succeeds, and then reported.
+    let p = dep_and_app(
+        "pub fn f() -> u32 { 1 }",
+        "fn main() { let unused = dep::f(); }",
+    );
+
+    p.cargo("check -Zheadstart")
+        .masquerade_as_nightly_cargo(&["headstart"])
+        .with_stderr_contains("[WARNING] unused variable: `unused`")
+        .with_stderr_contains("[WARNING] `app` (bin \"app\") generated 1 warning[..]")
+        .run();
+
+    p.change_file(
+        "app/src/main.rs",
+        "fn main() { let x: u32 = dep::f() == 1; }",
+    );
+    p.cargo("check -Zheadstart")
+        .masquerade_as_nightly_cargo(&["headstart"])
+        .with_status(101)
+        .with_stderr_contains("error[E0308]: mismatched types")
+        .with_stderr_contains(
+            "[ERROR] could not compile `app` (bin \"app\") due to 1 previous error",
+        )
+        .run();
