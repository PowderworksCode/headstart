--- a/src/compiler/job_queue/job_state.rs
+++ b/src/compiler/job_queue/job_state.rs
@@ -50,6 +50,9 @@ pub struct JobState<'a, 'gctx> {
     /// sending a double message later on.
     rmeta_required: Cell<bool>,
 
+    /// Whether `rmeta_produced` has released this unit's dependents already.
+    rmeta_announced: Cell<bool>,
+
     /// Manages locks for build units when fine grain locking is enabled.
     lock_manager: Arc<LockManager>,
 
@@ -74,6 +77,7 @@ impl<'a, 'gctx> JobState<'a, 'gctx> {
             messages,
             output,
             rmeta_required: Cell::new(rmeta_required),
+            rmeta_announced: Cell::new(false),
             lock_manager,
             warning_handling,
             _marker: marker::PhantomData,
@@ -147,9 +151,15 @@ impl<'a, 'gctx> JobState<'a, 'gctx> {
     /// A method used to signal to the coordinator thread that the rmeta file
     /// for an rlib has been produced. This is only called for some rmeta
     /// builds when required, and can be called at any time before a job ends.
-    /// This should only be called once because a metadata file can only be
-    /// produced once!
+    ///
+    /// Only the first call has an effect. With headstart, rustc announces
+    /// early metadata and then full metadata, and both call this.
     pub fn rmeta_produced(&self) {
+        // With headstart, rustc announces early and then full metadata;
+        // dependents are released on the first.
+        if self.rmeta_announced.replace(true) {
+            return;
+        }
         self.rmeta_required.set(false);
         self.messages
             .push(Message::Finish(self.id, Artifact::Metadata, Ok(())));
