+    if build_runner.headstart_enabled() {
+        cmd.arg("-Zearly-metadata");
+    }
     if unit.mode.is_check() {
         cmd.arg("--emit=dep-info,metadata");
     } else if !build_runner
@@ -2359,13 +2365,27 @@ fn on_stderr_line_inner(
     struct ArtifactNotification<'a> {
         #[serde(borrow)]
         artifact: Cow<'a, str>,
+        #[serde(borrow, default)]
+        emit: Option<Cow<'a, str>>,
     }
 
     if let Ok(artifact) = serde_json::from_str::<ArtifactNotification<'_>>(compiler_message.get()) {
         trace!("found directive from rustc: `{}`", artifact.artifact);
-        if artifact.artifact.ends_with(".rmeta") {
-            debug!("looks like metadata finished early!");
-            state.rmeta_produced();
+        match artifact.emit.as_deref() {
+            // Headstart: early metadata (`-Zearly-metadata`) is enough for
+            // dependents to start; full metadata follows.
+            Some("early-metadata") => {
+                debug!("early metadata written");
+                state.rmeta_produced();
+            }
+            // Headstart: rustc waiting for a dependency's full metadata or
+            // rlib, and continuing; not this unit's metadata.
+            Some("wait-metadata" | "resume") => {}
+            _ if artifact.artifact.ends_with(".rmeta") => {
+                debug!("looks like metadata finished early!");
+                state.rmeta_produced();
+            }
+            _ => {}
         }
         return Ok(false);
     }
