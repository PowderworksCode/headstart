@@ -453,7 +453,17 @@ impl<'gctx> JobQueue<'gctx> {
         // the target as well. This should ensure that edges changed to
         // `Metadata` propagate upwards `All` dependencies to anything that
         // transitively contains the `Metadata` edge.
-        if unit.requires_upstream_objects() {
+        //
+        // Headstart: a unit compiled by rustc needs only its direct
+        // dependencies' metadata, whose own dependencies' metadata came first.
+        // A check unit never links; one that does waits for the rlibs itself
+        // before linking.
+        let rustc_waits_for_rlibs = build_runner.headstart_enabled()
+            && matches!(
+                unit.mode,
+                CompileMode::Build | CompileMode::Test | CompileMode::Check { .. }
+            );
+        if unit.requires_upstream_objects() && !rustc_waits_for_rlibs {
             for dep in dependencies {
                 depend_on_deps_of_deps(build_runner, &mut queue_deps, dep.unit.clone());
             }
