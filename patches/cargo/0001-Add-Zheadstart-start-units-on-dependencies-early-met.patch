index 0000000..2203f72
--- /dev/null
+++ b/tests/testsuite/headstart.rs
@@ -0,0 +1,166 @@
+//! Tests for `-Zheadstart`: units start on their dependencies' early metadata
+//! (rustc's `-Zearly-metadata`).
+
+use std::path::PathBuf;
+
+use crate::prelude::*;
+use cargo_test_support::{Project, basic_manifest, project, str};
+use filetime::FileTime;
+
+/// A library `dep` and a binary `app` that uses it, with the given sources.
+fn dep_and_app(dep: &str, app: &str) -> Project {
+    project()
+        .file(
+            "Cargo.toml",
+            r#"
+                [workspace]
+                members = ["dep", "app"]
+                resolver = "2"
+            "#,
+        )
+        .file("dep/Cargo.toml", &basic_manifest("dep", "0.0.1"))
+        .file("dep/src/lib.rs", dep)
+        .file(
+            "app/Cargo.toml",
+            r#"
+                [package]
+                name = "app"
+                version = "0.0.1"
+                edition = "2015"
+
+                [dependencies]
+                dep = { path = "../dep" }
+            "#,
+        )
+        .file("app/src/main.rs", app)
+        .build()
+}
+
+#[cargo_test]
+fn headstart_stable() {
+    let p = project().file("src/lib.rs", "").build();
+
+    p.cargo("check -Zheadstart")
+        .with_status(101)
+        .with_stderr_data(str![[r#"
+[ERROR] the `-Z` flag is only accepted on the nightly channel of Cargo, but this is the `stable` channel
+See https://doc.rust-lang.org/book/appendix-07-nightly-rust.html for more information about Rust release channels.
+
+"#]])
+        .run();
+}
+
+#[cargo_test(nightly, reason = "-Zearly-metadata is unstable")]
+fn passes_early_metadata() {
+    let p = dep_and_app("pub fn f() -> u32 { 1 }", "fn main() { dep::f(); }");
+
+    p.cargo("check -v -Zheadstart")
+        .masquerade_as_nightly_cargo(&["headstart"])
+        .with_stderr_data(
+            str![[r#"
+[CHECKING] dep v0.0.1 ([ROOT]/foo/dep)
+[RUNNING] `rustc --crate-name dep [..]-Zearly-metadata[..]`
+[CHECKING] app v0.0.1 ([ROOT]/foo/app)
+[RUNNING] `rustc --crate-name app [..]-Zearly-metadata[..]`
+[FINISHED] `dev` profile [unoptimized + debuginfo] target(s) in [ELAPSED]s
+
+"#]]
+            .unordered(),
+        )
+        .run();
+    assert_eq!(p.glob("target/debug/**/libdep-*.early-rmeta").count(), 1);
+}
+
+#[cargo_test(nightly, reason = "-Zearly-metadata is unstable")]
+fn relinks_when_dependency_rlib_changes() {
+    // A binary starts on its dependencies' metadata, but links their rlibs: a
+    // newer rlib must make it stale even if the metadata didn't change.
+    let p = dep_and_app("pub fn f() -> u32 { 1 }", "fn main() { dep::f(); }");
+
+    p.cargo("build -Zheadstart")
+        .masquerade_as_nightly_cargo(&["headstart"])
+        .run();
+    let rlib: PathBuf = p
+        .glob("target/debug/**/libdep-*.rlib")
+        .next()
+        .unwrap()
+        .unwrap();
+    let later = FileTime::from_unix_time(FileTime::now().unix_seconds() + 10, 0);
+    filetime::set_file_mtime(&rlib, later).unwrap();
+
+    p.cargo("build -v -Zheadstart")
+        .masquerade_as_nightly_cargo(&["headstart"])
+        .with_stderr_contains("[DIRTY] app v0.0.1 ([ROOT]/foo/app): [..]")
+        .run();
+}
+
+#[cargo_test(nightly, reason = "-Zearly-metadata is unstable")]
+fn all_unit_kinds_one_job() {
+    // A build script, a proc macro, a library, a binary and an integration
+    // test, all started on early metadata where they can be.
+    let p = project()
+        .file(
+            "Cargo.toml",
+            r#"
+                [package]
+                name = "foo"
+                version = "0.0.1"
+                edition = "2021"
+                build = "build.rs"
+
+                [dependencies]
+                mac = { path = "mac" }
+                dep = { path = "dep" }
+
+                [build-dependencies]
+                dep = { path = "dep" }
+            "#,
+        )
+        .file("build.rs", "fn main() { assert_eq!(dep::f(), 1); }")
+        .file("src/lib.rs", "pub fn g() -> u32 { mac::one!() + dep::f() }")
+        .file("src/main.rs", "fn main() { assert_eq!(foo::g(), 2); }")
+        .file("tests/t.rs", "#[test] fn t() { assert_eq!(foo::g(), 2); }")
+        .file("dep/Cargo.toml", &basic_manifest("dep", "0.0.1"))
+        .file("dep/src/lib.rs", "pub fn f() -> u32 { 1 }")
+        .file(
+            "mac/Cargo.toml",
+            r#"
+                [package]
+                name = "mac"
+                version = "0.0.1"
+                edition = "2021"
+
+                [lib]
+                proc-macro = true
+
+                [dependencies]
+                dep = { path = "../dep" }
+            "#,
+        )
+        .file(
+            "mac/src/lib.rs",
+            r#"
+                extern crate proc_macro;
+                use proc_macro::TokenStream;
+
+                #[proc_macro]
+                pub fn one(_: TokenStream) -> TokenStream {
+                    dep::f().to_string().parse().unwrap()
+                }
+            "#,
+        )
+        .build();
+
+    for jobs in ["1", "4"] {
+        p.cargo("test -Zheadstart -j")
+            .arg(jobs)
+            .masquerade_as_nightly_cargo(&["headstart"])
+            .with_stdout_contains("test t ... ok")
+            .run();
+        p.cargo("run -Zheadstart -j")
+            .arg(jobs)
+            .masquerade_as_nightly_cargo(&["headstart"])
+            .run();
+        p.cargo("clean").run();
+    }
+}
