diff --git a/compiler/rustc_metadata/src/rmeta/decoder/cstore_impl.rs b/compiler/rustc_metadata/src/rmeta/decoder/cstore_impl.rs
index 154cf4f06..5db727e9e 100644
--- a/compiler/rustc_metadata/src/rmeta/decoder/cstore_impl.rs
+++ b/compiler/rustc_metadata/src/rmeta/decoder/cstore_impl.rs
@@ -94,6 +94,32 @@ fn process_decoded(self, _tcx: TyCtxt<'_>, _err: impl Fn() -> !) -> Option<Depre
     }
 }
 
+/// Queries that only full metadata answers; early metadata
+/// (`-Zearly-metadata`) leaves their data out. `is_mir_available` is checked
+/// where it answers no.
+const FULL_METADATA_QUERIES: &[&str] = &[
+    "cross_crate_inlinable",
+    "deduced_param_attrs",
+    "reachable_non_generics",
+    "exported_non_generic_symbols",
+    "exported_generic_symbols",
+    "required_panic_strategy",
+];
+
+/// `-Zearly-metadata-verify`: reports a query that only full metadata can
+/// answer, asked about a crate still loaded from early metadata. The answer
+/// would be wrong, and would stay cached after the full metadata is loaded.
+///
+/// Printed to stderr rather than as a diagnostic, like `-Zprint-*` output:
+/// build tools hide the diagnostics of dependencies, and this concerns
+/// every crate in the build.
+fn verify_not_early(tcx: TyCtxt<'_>, krate: CrateNum, query: &str) {
+    eprintln!(
+        "early-metadata-verify: `{query}` of `{}` answered from early metadata",
+        tcx.crate_name(krate)
+    );
+}
+
 macro_rules! provide_one {
     ($tcx:ident, $def_id:ident, $other:ident, $cdata:ident, $name:ident => { table }) => {
         provide_one! {
@@ -156,6 +182,12 @@ fn $name<'tcx>(
 
             let cstore = CStore::from_tcx($tcx);
             let $cdata = cstore.get_crate_data($def_id.krate);
+            if $tcx.sess.opts.unstable_opts.early_metadata_verify
+                && $cdata.is_early()
+                && FULL_METADATA_QUERIES.contains(&stringify!($name))
+            {
+                verify_not_early($tcx, $def_id.krate, stringify!($name));
+            }
 
             $compute
         }
@@ -329,7 +361,13 @@ fn into_args(self) -> (DefId, SimplifiedType) {
     associated_item => { cdata.get_associated_item(tcx, def_id.index) }
     inherent_impls => { cdata.get_inherent_implementations_for_type(tcx, def_id.index) }
     attrs_for_def => { tcx.arena.alloc_from_iter(cdata.get_item_attrs(tcx, def_id.index)) }
-    is_mir_available => { cdata.is_item_mir_available(def_id.index) }
+    is_mir_available => {
+        let available = cdata.is_item_mir_available(def_id.index);
+        if !available && tcx.sess.opts.unstable_opts.early_metadata_verify && cdata.is_early() {
+            verify_not_early(tcx, def_id.krate, "is_mir_available");
+        }
+        available
+    }
     cross_crate_inlinable => { table_direct }
 
     dylib_dependency_formats => { cdata.get_dylib_dependency_formats(tcx) }
diff --git a/compiler/rustc_metadata/src/rmeta/encoder.rs b/compiler/rustc_metadata/src/rmeta/encoder.rs
index 9c38332c7..6feb4eb1a 100644
--- a/compiler/rustc_metadata/src/rmeta/encoder.rs
+++ b/compiler/rustc_metadata/src/rmeta/encoder.rs
@@ -1989,19 +1989,38 @@ fn interface_bodies(&mut self) -> &FxHashSet<LocalDefId> {
     }
 
     /// Encodes the deferred MIR and definitions nested in interface bodies.
+    /// With `-Zearly-metadata-verify`, reports any left out whose body was
+    /// type-checked anyway: a body `interface_bodies` should have included.
     fn encode_deferred(&mut self) {
+        let verify = self.tcx.sess.opts.unstable_opts.early_metadata_verify;
         for (def_id, body, c, o) in std::mem::take(&mut self.deferred_mir) {
             if self.interface_bodies().contains(&body) {
                 self.encode_mir_for(def_id, c, o);
+            } else if verify {
+                self.report_missed_body(def_id, body);
             }
         }
         for (def_id, body) in std::mem::take(&mut self.deferred_defs) {
             if self.interface_bodies().contains(&body) {
                 self.encode_info_for_def(def_id);
+            } else if verify {
+                self.report_missed_body(def_id, body);
             }
         }
     }
 
+    /// Printed to stderr like `verify_not_early`'s reports, for the same reason.
+    fn report_missed_body(&self, def_id: LocalDefId, body: LocalDefId) {
+        if self.tcx.typeck_is_done(body) {
+            eprintln!(
+                "early-metadata-verify: left out `{}`, but `{}` was type-checked \
+                 during the early write",
+                self.tcx.def_path_debug_str(def_id.to_def_id()),
+                self.tcx.def_path_debug_str(body.to_def_id()),
+            );
+        }
+    }
+
     /// `should_encode_mir`, for the kind of metadata being written.
     fn should_encode_mir(&self, def_id: LocalDefId) -> (bool, bool) {
         let tcx = self.tcx;
