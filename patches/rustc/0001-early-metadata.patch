+/// Metadata written by [`write_early_metadata`], for [`start_codegen`] to use
+/// instead of encoding it again.
+static EARLY_METADATA: std::sync::Mutex<Option<EncodedMetadata>> = std::sync::Mutex::new(None);
+
+/// `-Zearly-metadata`: write the crate's metadata (and announce it, with
+/// `--json=artifacts`) once item interfaces are checked, before function
+/// bodies are, so a build tool can start dependent crates sooner. Whatever the
+/// metadata needs from a body (an opaque type's hidden type, a const's value)
+/// is computed on demand here. If a body fails to check later, compilation
+/// still fails; the metadata was only ever an early promise.
+fn write_early_metadata(tcx: TyCtxt<'_>) {
+    // Only for metadata-only builds (`cargo check`): early metadata leaves out
+    // what only codegen and linking read, so it must not go into an rlib.
+    if !tcx.sess.opts.output_types.contains_key(&OutputType::Metadata)
+        || tcx.sess.opts.output_types.should_codegen()
+        || tcx.sess.dcx().has_errors_or_delayed_bugs().is_some()
+    {
+        return;
+    }
+    // Encoding freezes the definitions table, so first create the
+    // definitions that checking bodies adds: statics' nested allocations and
+    // async closures' by-move bodies. This checks those bodies now (in
+    // order, as `check_crate_bodies` does, for reproducible `DefId`s).
+    tcx.hir_body_owners().for_each(|def_id| {
+        if let rustc_hir::def::DefKind::Static { .. } = tcx.def_kind(def_id) {
+            tcx.ensure_ok().eval_static_initializer(def_id);
+        }
+        if tcx.needs_coroutine_by_move_body_def_id(def_id.to_def_id()) {
+            tcx.ensure_done().coroutine_by_move_body_def_id(def_id);
+        }
+    });
+    if tcx.sess.dcx().has_errors_or_delayed_bugs().is_some() {
+        return;
+    }
+    tcx.sess.encoding_early_metadata.store(true, std::sync::atomic::Ordering::Relaxed);
+    let encoded = rustc_metadata::fs::encode_and_write_metadata(tcx);
+    tcx.sess.encoding_early_metadata.store(false, std::sync::atomic::Ordering::Relaxed);
+    if let Ok(metadata) = encoded {
+        *EARLY_METADATA.lock().unwrap() = Some(metadata);
+    }
+}
