+/// While this compilation waits for dependencies' full metadata, it hands its
+/// jobserver token back so the build tool can run other work, and announces it
+/// (a `wait-metadata` artifact notification). It takes a token again before
+/// resuming (a `resume` notification).
+#[derive(Default)]
+struct Pause {
+    paused: bool,
+}
+
+impl Pause {
+    fn pause(&mut self, tcx: TyCtxt<'_>, waiting_for: &Path) {
+        if self.paused {
+            return;
+        }
+        self.paused = true;
+        if tcx.sess.opts.json_artifact_notifications {
+            tcx.dcx().emit_artifact_notification(waiting_for, "wait-metadata");
+        }
+        // This gives up the token this process runs on, which the jobserver
+        // proxy never does; `resume` takes one back before any more work.
+        rustc_data_structures::jobserver::client().release_raw().ok();
+    }
+
+    fn resume(&mut self, tcx: TyCtxt<'_>) {
+        if !self.paused {
+            return;
+        }
+        self.paused = false;
+        rustc_data_structures::jobserver::client().acquire_raw().ok();
+        if tcx.sess.opts.json_artifact_notifications {
+            tcx.dcx().emit_artifact_notification(Path::new(""), "resume");
+        }
+    }
+}
+
+/// Waits until the full metadata of the crate whose early metadata is at
+/// `early_path` is written: a file with the same crate hash. (One left over
+/// from an earlier compilation with the same hash describes the same crate.)
+/// Fails if the build tool marks the crate as failed (a `.failed-rmeta` file,
+/// which it deletes whenever the crate starts compiling), since then it
+/// never will be.
+fn wait_for_full_metadata(
+    tcx: TyCtxt<'_>,
+    metadata_loader: &dyn MetadataLoader,
+    early_path: &Path,
+    hash: Svh,
+    pause: &mut Pause,
+) -> (MetadataBlob, PathBuf) {
+    let full_path = crate::locator::full_metadata_path(early_path);
+    let failed_path = full_path.with_extension("failed-rmeta");
+    loop {
+        // A file with another hash is stale, and will be replaced.
+        if let Ok(blob) = crate::locator::get_metadata_section(
+            &tcx.sess.target,
+            crate::locator::CrateFlavor::Rmeta,
+            &full_path,
+            metadata_loader,
+            tcx.sess.cfg_version,
+            None,
+        ) && blob.get_crate_hash() == hash
+        {
+            return (blob, full_path);
+        }
+        if failed_path.exists() {
+            tcx.dcx().fatal(format!(
+                "a dependency failed to compile after writing early metadata `{}`",
+                early_path.display()
+            ));
+        }
+        pause.pause(tcx, &full_path);
+        std::thread::sleep(std::time::Duration::from_millis(10));
+    }
+}
